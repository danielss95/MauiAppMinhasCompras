<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Padding="10" Spacing="6">
        <Label Text="Descrição do produto:" />
        <Entry x:Name="txt_descricao" />

        <Label Text="Quantidade:" />
        <Entry x:Name="txt_quantidade" Keyboard="Numeric" />

        <Label Text="Preço:" />
        <Entry x:Name="txt_preco" Keyboard="Numeric" />

        <Label Text="Categoria:" />
        <Picker x:Name="pck_categoria" Title="Selecione a categoria" />

        <Label Text="Data da compra:" />
        <DatePicker x:Name="dtp_data" />
    </VerticalStackLayout>
</ContentPage>